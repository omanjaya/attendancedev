[Unit]
Description=Face Recognition Service
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/attendance/python-face-service
Environment="PATH=/var/www/attendance/python-face-service/venv/bin"
ExecStart=/var/www/attendance/python-face-service/venv/bin/gunicorn \
    --bind 127.0.0.1:5000 \
    --workers 2 \
    --timeout 120 \
    --access-logfile /var/log/face-recognition/access.log \
    --error-logfile /var/log/face-recognition/error.log \
    app:app

Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
