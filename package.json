{
  "name": "attendance-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "shared"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:backend dev:frontend",
    "dev:backend": "cd backend && php artisan serve",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm-run-all build:shared build:frontend build:backend",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && composer install --no-dev --optimize-autoloader",
    "build:shared": "cd shared && npm run build",
    "test": "npm-run-all test:backend test:frontend",
    "test:backend": "cd backend && php artisan test",
    "test:frontend": "cd frontend && npm run test:run",
    "test:e2e": "cd frontend && npm run test:e2e",
    "lint": "cd frontend && npm run lint",
    "quality": "cd frontend && npm run quality",
    "prepare": "husky"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
