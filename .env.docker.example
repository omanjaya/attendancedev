# ============================================
# Docker Environment Configuration
# ============================================
# Copy this file to .env for Docker deployment
# ============================================

# Application
APP_NAME="Attendance System"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://attendance.yourdomain.com
APP_KEY=base64:YOUR_APP_KEY_HERE

# Database (PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=attendance_system
DB_USERNAME=attendance_user
DB_PASSWORD=CHANGE_THIS_SECURE_PASSWORD

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD

# Session & Cache
SESSION_DRIVER=redis
CACHE_DRIVER=redis
QUEUE_CONNECTION=database

# Frontend URLs (for build time)
VITE_API_BASE_URL=https://attendance.yourdomain.com/api
VITE_DEEPFACE_URL=https://attendance.yourdomain.com/deepface

# DeepFace Configuration
DEEPFACE_BASE_URL=http://deepface-1:8001
DEEPFACE_THRESHOLD=0.68
DEEPFACE_LIVENESS_ENABLED=true

# Email (optional)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Timezone
APP_TIMEZONE=Asia/Jakarta
