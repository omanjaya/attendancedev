APP_NAME=Laravel
APP_ENV=production
APP_KEY=

# IMPORTANT: Set APP_DEBUG=false in production!
# APP_DEBUG=true will expose sensitive error information
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration
# ----------------------
# PostgreSQL (Recommended for production and development)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=attendance_system
DB_USERNAME=attendance_user
DB_PASSWORD=YOUR_SECURE_PASSWORD_HERE

# SQLite (Alternative for quick local development)
# DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_EXPIRE_ON_CLOSE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_PORT=6379

# ============================================================================
# Email Configuration
# ============================================================================
# Mailer Options: smtp, ses, mailgun, postmark, sendmail, log, array
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# For Gmail SMTP (example):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=your-email@gmail.com
# MAIL_FROM_NAME="${APP_NAME}"

# Email Notification Settings
EMAIL_NOTIFY_CHECK_IN=true
EMAIL_NOTIFY_CHECK_OUT=true
EMAIL_NOTIFY_LATE=true
EMAIL_NOTIFY_ABSENT=true
EMAIL_NOTIFY_PASSWORD_RESET=true
EMAIL_NOTIFY_WELCOME=true


AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Payroll Configuration
PAYROLL_STANDARD_HOURS_PER_DAY=8
PAYROLL_WORKING_DAYS_PER_MONTH=22
PAYROLL_OVERTIME_MULTIPLIER=1.5
PAYROLL_PAY_DATE_DAY=15

# Tax Configuration
PAYROLL_TAX_BRACKET_1_MAX=1000
PAYROLL_TAX_BRACKET_1_RATE=0
PAYROLL_TAX_BRACKET_2_MAX=3000
PAYROLL_TAX_BRACKET_2_RATE=10
PAYROLL_TAX_BRACKET_3_MAX=5000
PAYROLL_TAX_BRACKET_3_RATE=15
PAYROLL_TAX_BRACKET_4_RATE=20

# Statutory Deductions
PAYROLL_SOCIAL_SECURITY_ENABLED=true
PAYROLL_SOCIAL_SECURITY_RATE=6.2
PAYROLL_SOCIAL_SECURITY_CAP=10000
PAYROLL_MEDICARE_ENABLED=true
PAYROLL_MEDICARE_RATE=1.45
PAYROLL_UNEMPLOYMENT_ENABLED=false
PAYROLL_UNEMPLOYMENT_RATE=0.6
PAYROLL_UNEMPLOYMENT_CAP=7000

# Bonuses
PAYROLL_PERFECT_ATTENDANCE_BONUS_ENABLED=true
PAYROLL_PERFECT_ATTENDANCE_BONUS_AMOUNT=100
PAYROLL_PERFORMANCE_BONUS_ENABLED=false
PAYROLL_OVERTIME_BONUS_ENABLED=false

# Validation
PAYROLL_MINIMUM_WAGE=7.25
PAYROLL_MAX_HOURS_PER_PERIOD=200
PAYROLL_MAX_OVERTIME_HOURS=60

# Features
PAYROLL_AUTO_CALCULATE_OVERTIME=true
PAYROLL_AUTO_APPLY_BONUSES=true
PAYROLL_AUTO_CALCULATE_TAXES=true

# ============================================================================
# Face Recognition Service
# ============================================================================
# Python Flask service for server-side face recognition processing
FACE_RECOGNITION_SERVICE_URL=http://127.0.0.1:5000
FACE_RECOGNITION_SERVICE_TIMEOUT=30
FACE_RECOGNITION_TOLERANCE=0.6

# ============================================================================
# DeepFace Service Cluster Configuration (NEW - High Performance)
# ============================================================================
# Enable DeepFace ArcFace model (99.82% accuracy)
DEEPFACE_ENABLED=true
DEEPFACE_BASE_URL=http://127.0.0.1

# DeepFace service ports (comma-separated for load balancing)
# Add more ports to scale: 8001,8002,8003,8004,8005
# Each instance handles ~30 requests/minute
DEEPFACE_PORTS=8001,8002,8003,8004,8005

# Request timeout (seconds)
DEEPFACE_TIMEOUT=30

# Health check interval (seconds)
DEEPFACE_HEALTH_CHECK_INTERVAL=30

# Max retries before giving up
DEEPFACE_MAX_RETRIES=2

# Face verification threshold (0-1, lower = stricter)
# ArcFace recommended: 0.68
DEEPFACE_THRESHOLD=0.68

# Enable liveness detection (anti-spoofing)
DEEPFACE_LIVENESS_ENABLED=true

# Cache embeddings in Redis for faster verification
DEEPFACE_CACHE_EMBEDDINGS=true

# Embedding cache TTL (seconds)
DEEPFACE_CACHE_TTL=3600

# ================================================
# ATTENDANCE SYSTEM CONFIGURATION
# ================================================

# Strict Mode: Enforce monthly schedule validation
# true = Employees MUST have schedules assigned (Production)
# false = Allow attendance without schedules (Development/Testing)
ATTENDANCE_STRICT_MODE=true

# Roles that can bypass schedule validation
# Comma-separated list of role names
# Example: super_admin,admin,tester
ATTENDANCE_BYPASS_ROLES=super_admin

# Enable audit logging for all bypass activities
# Recommended: true for compliance and security
ATTENDANCE_LOG_BYPASS=true

# Enable/disable time window validation
# false = Allow check-in/out at any time (useful for testing)
ATTENDANCE_VALIDATE_TIME_WINDOWS=true

# Enable/disable working day validation
# false = Allow check-in/out on any day (useful for testing)
ATTENDANCE_VALIDATE_WORKING_DAYS=true

# Maintenance Mode: Bypass all validations temporarily
# Use only during system migrations or emergencies
ATTENDANCE_MAINTENANCE_MODE=false

# ============================================================================
# CORS Configuration
# ============================================================================
# Allowed origins for CORS (comma-separated for multiple origins)
# Production: CORS_ALLOWED_ORIGINS=https://absensi.patra.co.id
# Development: CORS_ALLOWED_ORIGINS=https://absensi.patra.co.id,http://localhost:5173
# IMPORTANT: Always set specific origins in production, never use wildcard (*)
CORS_ALLOWED_ORIGINS=https://absensi.patra.co.id

